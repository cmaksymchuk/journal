# Copy to .env.local and fill in real values.

# Access key (recommended): create at jsonbin.io → API Keys with Bins Read + Bins Update
JSONBIN_ACCESS_KEY=your-access-key

# Or use Master Key instead (leave JSONBIN_ACCESS_KEY unset):
# JSONBIN_API_KEY=your-master-key

JSONBIN_BIN_ID=your-bin-id
APP_PASSWORD=your-shared-password
APP_TOKEN=generate-with-openssl-rand-hex-16
